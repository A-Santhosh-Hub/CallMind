<?xml version="1.0" encoding="utf-8"?>
<!-- Floating incoming-call card: round avatar, name and number on two lines, a red decline and a green answer button. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="2dp"
    android:paddingTop="6dp"
    android:paddingEnd="2dp"
    android:paddingBottom="6dp">

    <ImageView
        android:id="@+id/call_avatar"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/call_name"
            style="@style/TextAppearance.Compat.Notification.Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/call_detail"
            style="@style/TextAppearance.Compat.Notification"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:textSize="13sp" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/call_decline"
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/bg_round_red"
        android:contentDescription="Decline"
        android:padding="11dp"
        android:src="@drawable/ic_call_decline" />

    <ImageButton
        android:id="@+id/call_answer"
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:layout_marginStart="10dp"
        android:background="@drawable/bg_round_green"
        android:contentDescription="Answer"
        android:padding="11dp"
        android:src="@drawable/ic_call_answer" />
</LinearLayout>
